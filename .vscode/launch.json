{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "go",
      "name": "Go: Claw",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/go/cmd/claw",
      "cwd": "${workspaceFolder}/go",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "Java: Claw",
      "request": "launch",
      "mainClass": "com.egjaedong.tinyclaw.Claw",
      "projectName": "tiny-claw",
      "cwd": "${workspaceFolder}/java",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "name": "TS: Claw",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/ts/node_modules/.bin/tsx",
      "args": ["src/claw.ts"],
      "cwd": "${workspaceFolder}/ts",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Claw",
      "type": "debugpy",
      "request": "launch",
      "module": "tiny_claw",
      "cwd": "${workspaceFolder}/python",
      "python": "${workspaceFolder}/python/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
