{
  // 仅本仓库关 Cursor Tab（AI 灰字补全），不影响其他项目。
  "editor.inlineSuggest.enabled": false,
  "cursor.cpp.disabledLanguages": [
    "go",
    "java",
    "javascript",
    "json",
    "markdown",
    "plaintext",
    "properties",
    "shellscript",
    "yaml"
  ],

  // 必须走 java/ 的 Gradle 工程导入。不要设 java.project.sourcePaths / outputPath，
  // 否则会变成没有 JRE 的 unmanaged 工程，Lombok 生成的构造器会报 Object() undefined。
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,
  "java.import.maven.enabled": false,
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.configuration.detectJdksAtStart": true,
  "java.jdt.ls.lombokSupport.enabled": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/bin/python",
  "python.analysis.extraPaths": ["${workspaceFolder}/python/src"],
  "typescript.tsdk": "ts/node_modules/typescript/lib"
}
